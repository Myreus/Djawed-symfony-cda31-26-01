{% extends "base.html.twig" %}
{% block title %} 
Liste des livres
{% endblock %}
{% block body %}
<ul>
    {% if books %}
    <p>Liste des livres </p>
        {% for book in books %}
        <li>{{ book.title }} : {{ book.author }}</li>
        {% endfor %}
    {% else %}
    <p>La liste est vide</p>
    {% endif %}
</ul>
{% endblock %}